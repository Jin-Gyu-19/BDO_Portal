# ============================================================
#  SH Portal SSO (oauth2-proxy) 환경 변수
#  NAS 경로: /volume1/sh-pf/docker/sh-platform/sso/.env.sso   ← 이 파일을 복사해 값 채우기
#  ※ 실제 값이 든 .env.sso 는 절대 git에 올리지 않는다
# ============================================================

# ── Entra ID 앱 등록에서 복사 (sso/entra-app-registration.md 참조) ──
TENANT_ID=00000000-0000-0000-0000-000000000000
OAUTH2_PROXY_CLIENT_ID=00000000-0000-0000-0000-000000000000
OAUTH2_PROXY_CLIENT_SECRET=여기에_클라이언트_비밀값

# ── 세션 쿠키 서명 키 (32바이트 랜덤, base64). 아래 명령으로 생성 ──
#   python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
OAUTH2_PROXY_COOKIE_SECRET=여기에_생성한_값

# ── 포털의 공개 주소 (DSM 역방향 프록시 https). Entra redirect URI 와 정확히 같아야 함 ──
PORTAL_URL=https://192.168.100.25:8081
