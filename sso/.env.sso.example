# ============================================================
#  SH Portal SSO (oauth2-proxy) 환경 변수
#  NAS 경로: /volume1/sh-pf/docker/sh-platform/sso/.env.sso   ← 이 파일을 복사해 값 채우기
#  ※ 실제 값이 든 .env.sso 는 절대 git에 올리지 않는다 (chmod 600)
#  ※ 값에 따옴표를 쓰지 않는다
# ============================================================

# ── Entra 앱 등록 → 개요 ──
#   디렉터리(테넌트) ID 를 아래 URL 의 <TENANT_ID> 자리에 넣는다
OAUTH2_PROXY_OIDC_ISSUER_URL=https://login.microsoftonline.com/<TENANT_ID>/v2.0
#   애플리케이션(클라이언트) ID
OAUTH2_PROXY_CLIENT_ID=<CLIENT_ID>
#   인증서 및 비밀 → 클라이언트 비밀 "값"
OAUTH2_PROXY_CLIENT_SECRET=<CLIENT_SECRET>

# ── 포털 공개 주소 + /oauth2/callback (Entra 리디렉션 URI 와 정확히 일치) ──
OAUTH2_PROXY_REDIRECT_URL=https://192.168.100.25:8081/oauth2/callback

# ── 세션 쿠키 서명 키 (32바이트 랜덤, base64). 아래 명령으로 생성 ──
#   python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
OAUTH2_PROXY_COOKIE_SECRET=<COOKIE_SECRET>
